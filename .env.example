# Common runtime configuration
NODE_ENV=production
PORT=3000
# Optional override: defaults to info in production and debug otherwise.
# Remove this override for automatic development logging, or set debug for extra diagnostics.
LOG_LEVEL=info
JWT_SECRET=replace-with-a-long-random-secret
# Optional access-token lifetime; defaults to 15 minutes. Include a unit such as m or h.
# ACCESS_TOKEN_EXPIRATION=15m

# Trust a reverse proxy running on the same host (for example cloudflared or nginx)
TRUST_PROXY=loopback

# Neon production database
USE_NEON=true
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Comma-separated browser origins
ALLOWED_ORIGINS=

# Media uploads remain unavailable until both values are configured
MEDIA_UPLOADS_ENABLED=false
# UPLOAD_PATH=/var/lib/dys/uploads

# Local PostgreSQL configuration
# NODE_ENV=development
# USE_NEON=false
# DB_HOST=localhost
# DB_PORT=5432
# APP_USER=your-local-app-user
# APP_USER_PASSWORD=your-local-app-password
# DB_NAME=your-local-database
